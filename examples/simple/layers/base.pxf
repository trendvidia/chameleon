# Optional preamble — chameleon checks the asserted id against the
# chain entry that loaded this file. Mismatch is an error.
@header chameleon.v1.LayerHeader
{
  id = "base"
  # Generated by `chameleon hash base.pxf`. Hashes the schema body —
  # adding or editing fields inside @header does not change the hash.
  content_sha256 = "f38075764f27b34bdcc46845d5ad8c873a1b852667526651ac7b4b40c130ffdf"
}

# Schema-typed body — the consumer's config message is AppConfig with
# fields: domain, base_url, api_url, db_password (Secret), feature_flags.

# `domain` is the intermediate root variable. Both base_url and api_url
# interpolate against it, so a higher layer can override `domain` and
# re-resolve both URLs without self-referencing. See README "tweak
# rather than override" — `base_url = "dev.${base_url}"` cycles because
# interpolation runs post-merge against the final state.
domain   = "mybigproject.com"
base_url = "https://${domain}"
api_url  = "https://api.${domain}"

feature_flags = {
  "new_dashboard": false
  "fast_path":     true
}

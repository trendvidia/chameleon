# Compiled binaries
# Go-build output for cmd/<name>/ packages: by default lands at the
# repo root with the package name, OR in-package if built from inside
# cmd/...
/protoc-gen-chameleon-go
/cmd/protoc-gen-chameleon-go/protoc-gen-chameleon-go
/chameleon
/cmd/chameleon/chameleon
# `go build ./hack/changelog` lands here too. Run it with `go run` (what
# the Makefile targets do) and nothing appears; build it once and this
# keeps 2.7 MB of local object code out of the module zip.
/changelog
/hack/changelog/changelog
/bin/
*.exe
*.dll
*.so
*.dylib

# Test + coverage artifacts
*.test
*.out
coverage.*
/cov*.out

# Build / dist
/dist/
/build/

# Generated code from buf in examples/ (the example exists to show
# users how to invoke the plugin, not to ship the generated output).
/examples/buf/gen/

# vendor/ optional — only present if a downstream consumer runs
# `go mod vendor` for hermetic builds. Not part of source.
/vendor/

# IDE / editor state
/.idea/
/.vscode/
*.iml
*.swp
*.swo
*~
.history/

# OS noise
.DS_Store
Thumbs.db

# Local environment files (never commit secrets, even in tests).
.env
.env.local
*.sops.tmp

# Agent / assistant session state (auto-memory). Not part of the
# library; lives alongside the working tree by convention.
/memory/
